<?xml version="1.0" encoding="utf-8"?>
<!-- Ships inside the web app's package (build.sh): same package id, so the app may launch it. With
     api-version 8, on-boot and auto-restart the install failed ("Register application error"); the TV ignored on-boot anyway. -->
<manifest package="CouchTV001" version="0.4.0" api-version="6.0" xmlns="http://tizen.org/ns/packages">
  <profile name="tv" />
  <service-application appid="CouchTV001.Service" exec="CouchTor.Service.dll" type="dotnet" multiple="false" taskmanage="false" nodisplay="true">
    <label>CouchTor</label>
  </service-application>
  <privileges>
    <privilege>http://tizen.org/privilege/internet</privilege>
  </privileges>
</manifest>
